# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas free tier connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eselling

# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me

# The address people open in the browser. In development this is the Vite server.
# OAuth callbacks go through this address too, so the login cookie stays on one site.
PUBLIC_URL=http://localhost:5173

# Cloudinary free plan (dashboard shows these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook login (Meta for Developers > your app > Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email of the account that becomes admin when it registers or logs in
ADMIN_EMAIL=
